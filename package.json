{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run clean && vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:chat": "node --test tests/chat.test.mjs",
    "health:check": "curl -s http://localhost:3000/api/health/chat | node -e \"const d=require('fs').readFileSync('/dev/stdin','utf8');const r=JSON.parse(d);console.log(JSON.stringify(r,null,2));process.exit(r.status==='healthy'?0:1)\""
  },
