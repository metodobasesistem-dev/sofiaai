# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WhatsApp Provider Configuration
WHATSAPP_PROVIDER="uazapi" # uazapi | meta-cloud

# UAZAPI Configuration
UAZAPI_BASE_URL="https://api.uazapi.com"
UAZAPI_API_KEY="your_uazapi_key"
UAZAPI_WEBHOOK_SECRET="your_optional_secret"

# Meta Cloud API Configuration (Future)
META_ACCESS_TOKEN="your_meta_token"
META_PHONE_NUMBER_ID="your_phone_id"
META_BUSINESS_ACCOUNT_ID="your_business_id"

# OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key_here"
